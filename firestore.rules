rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFriendOf(userId) {
      return signedIn()
        && (request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.get("friends", [])
          || userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("friends", []));
    }

    function postIsActive(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.get("moderationStatus", null) == null
        && get(/databases/$(database)/documents/posts/$(postId)).data.get("deletedByAdmin", false) == false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.role == "user";
      allow update: if isAdmin()
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["role", "accountStatus", "profileArchivedByAdmin"]))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["friendRequests", "friends"]));
      allow delete: if isAdmin();
    }

    // Username is a unique public identifier. Exact-document reads are needed
    // before sign-in to resolve a username to Firebase Authentication email.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["uid", "email", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "email", "createdAt"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && !request.resource.data.keys().hasAny([
          "moderationStatus", "moderationReason", "moderatedAt", "moderatedBy",
          "deletedByAdmin", "restoredAt", "appeal"
        ]);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.authorId == request.auth.uid
          && resource.data.get("moderationStatus", null) == null
          && resource.data.get("deletedByAdmin", false) == false
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "moderationStatus", "moderationReason", "moderatedAt", "moderatedBy",
            "deletedByAdmin", "restoredAt"
          ])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["appeal"]))
        || (signedIn()
          && resource.data.authorId == request.auth.uid
          && resource.data.get("moderationStatus", "hidden") == "hidden"
          && resource.data.get("deletedByAdmin", false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["appeal"])
          && request.resource.data.appeal is map
          && request.resource.data.appeal.status == "pending"
          && request.resource.data.appeal.message is string
          && request.resource.data.appeal.message.size() >= 10
          && request.resource.data.appeal.message.size() <= 1000
          && request.resource.data.appeal.submittedAt == request.time
          && request.resource.data.appeal.keys().hasOnly([
            "status", "message", "submittedAt", "reviewedAt", "reviewNote"
          ]))
        || (signedIn()
          && resource.data.get("moderationStatus", null) == null
          && resource.data.get("deletedByAdmin", false) == false
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["reactions", "commentCount", "shareCount"]));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && postIsActive(postId);
        allow update: if isAdmin()
          || (signedIn()
            && postIsActive(postId)
            && resource.data.authorId == request.auth.uid)
          || (signedIn()
            && postIsActive(postId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["commentReactions"]));
        allow delete: if isAdmin()
          || (signedIn()
            && postIsActive(postId)
            && resource.data.authorId == request.auth.uid);
      }

      match /shares/{shareId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.sharerId == request.auth.uid
          && request.resource.data.recipientId is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(["sharerId", "recipientId", "createdAt"]);
        allow update, delete: if isAdmin();
      }
    }

    // Ứng dụng hiện đọc các thông báo theo collection rồi lọc ở client.
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow delete: if signedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    match /messageNotifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Mỗi thành viên chỉ có một ghi chú Messenger đang hoạt động.
    // Chỉ chủ sở hữu và người đã kết bạn mới có thể đọc ghi chú này.
    match /messengerNotes/{userId} {
      allow read: if isOwner(userId)
        || isFriendOf(userId)
        || (resource.data.get("visibleTo", []) is list
          && request.auth.uid in resource.data.get("visibleTo", []));
      allow create, update: if isOwner(userId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 160
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.visibleTo is list
        && request.resource.data.visibleTo.hasOnly(
          get(/databases/$(database)/documents/users/$(userId)).data.get("friends", []))
        && request.resource.data.keys().hasOnly(["authorId", "content", "createdAt", "expiresAt", "visibleTo"]);
      allow delete: if isOwner(userId);

      match /reactions/{reactorId} {
        allow get: if isOwner(userId) || isOwner(reactorId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(reactorId)
          && isFriendOf(userId)
          && exists(/databases/$(database)/documents/messengerNotes/$(userId))
          && get(/databases/$(database)/documents/messengerNotes/$(userId)).data.expiresAt > request.time
          && request.resource.data.keys().hasOnly(["reactorId", "type", "createdAt"])
          && request.resource.data.reactorId == request.auth.uid
          && request.resource.data.type in ["like", "love", "haha", "wow", "sad", "support"]
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(reactorId) || isOwner(userId);
      }
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid in resource.data.members
          // Hai phía có thể ghi cùng hai UID theo thứ tự khác nhau. So sánh
          // như một tập hợp để không chặn nhầm, nhưng vẫn cấm đổi thành viên.
          && request.resource.data.members is list
          && request.resource.data.members.size() == resource.data.members.size()
          && request.resource.data.members.hasAll(resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "members", "updatedAt", "typing", "nicknames", "theme", "appearance"
          ]));
      allow delete: if isAdmin();

      // Tùy chỉnh riêng của mỗi thành viên: nền cá nhân và trạng thái tắt thông báo.
      match /memberSettings/{userId} {
        allow read, delete: if signedIn()
          && request.auth.uid == userId
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.keys().hasOnly([
            "customBackgroundImageUrl", "customBackgroundPublicId",
            "customBackgroundFormat", "customBackgroundBytes",
            "customBackgroundWidth", "customBackgroundHeight",
            "customBackgroundEmoji",
            "backgroundOverlay", "backgroundBlur", "backgroundFit",
            "mutedUntil", "updatedAt"
          ]);
      }

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.recipientId in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow update: if isAdmin()
          || (signedIn()
            && resource.data.recipientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
            && request.resource.data.readAt == request.time)
          || (signedIn()
            && request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            && request.resource.data.reactions is map
            && request.resource.data.reactions.diff(resource.data.get("reactions", {}))
              .affectedKeys().hasOnly([request.auth.uid]))
          || (signedIn()
            && request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenFor"])
            && request.resource.data.hiddenFor is list
            && request.auth.uid in request.resource.data.hiddenFor
            && request.resource.data.hiddenFor.hasAll(resource.data.get("hiddenFor", []))
            && request.resource.data.hiddenFor.size() == resource.data.get("hiddenFor", []).size() + 1)
          || (signedIn()
            && resource.data.senderId == request.auth.uid
            && resource.data.get("revoked", false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "revoked", "revokedAt", "content", "mediaUrl", "mediaType", "mediaPublicId",
              "sharedPost", "noteReply", "replyTo", "reactions"
            ])
            && request.resource.data.revoked == true
            && request.resource.data.revokedAt == request.time
            && request.resource.data.content == "");
        allow delete: if isAdmin()
          || (signedIn() && resource.data.senderId == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
