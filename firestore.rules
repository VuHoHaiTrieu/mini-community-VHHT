rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function securityMigrationComplete() {
      return exists(/databases/$(database)/documents/system/securityMigration)
        && get(/databases/$(database)/documents/system/securityMigration).data.status == "complete"
        && get(/databases/$(database)/documents/system/securityMigration).data.get("schemaVersion", 0) == 2;
    }

    function friendshipDocumentId(firstId, secondId) {
      return firstId < secondId ? firstId + "_" + secondId : secondId + "_" + firstId;
    }

    function isFriendOf(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(friendshipDocumentId(request.auth.uid, userId)));
    }

    function postIsActive(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.get("moderationStatus", null) == null
        && get(/databases/$(database)/documents/posts/$(postId)).data.get("deletedByAdmin", false) == false;
    }

    function optionalBoundedString(data, field, maximum) {
      return !data.keys().hasAny([field])
        || (data[field] is string && data[field].size() <= maximum);
    }

    function optionalBoundedList(data, field, maximum) {
      return !data.keys().hasAny([field])
        || (data[field] is list && data[field].size() <= maximum);
    }

    function optionalCloudinaryUrl(data, field) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || (data[field] is string
          && data[field].size() <= 2048
          && data[field].matches('https://res\\.cloudinary\\.com/umrz1jtm/.*'));
    }

    function validPostMediaItem(item) {
      return item is map
        && item.keys().hasAll(["url", "type"])
        && item.url is string
        && item.url.size() <= 2048
        && item.url.matches('https://res\\.cloudinary\\.com/umrz1jtm/.*')
        && item.type in ["image", "video"]
        && (!item.keys().hasAny(["publicId"]) || item.publicId is string);
    }

    function optionalPostMediaList(data) {
      let items = data.get("attachedImages", []);
      return items is list
        && items.size() <= 4
        && (items.size() < 1 || validPostMediaItem(items[0]))
        && (items.size() < 2 || validPostMediaItem(items[1]))
        && (items.size() < 3 || validPostMediaItem(items[2]))
        && (items.size() < 4 || validPostMediaItem(items[3]));
    }

    function actorOwnsReactionChange(field) {
      let before = resource.data.get(field, {});
      let after = request.resource.data.get(field, {});
      return before is map
        && after is map
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!after.keys().hasAny([request.auth.uid])
          || after[request.auth.uid] in ["like", "love", "haha", "wow", "sad", "sorry", "support"]);
    }

    function boundedCounterChange(field) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return before is number
        && after is number
        && after >= 0
        && after <= 1000000000
        && after >= before - 1
        && after <= before + 1;
    }

    function hasOnlyPublicProfileFields(data) {
      return data.keys().hasOnly([
        "displayName", "fullName", "name", "avatar", "username", "usernameNormalized", "usernameConfigured",
        "profileImage", "photoURL", "photoPublicId", "coverURL", "coverPublicId",
        "biography", "location", "work", "education", "relationshipStatus",
        "createdAt", "role", "accountStatus",
        "profileArchivedByAdmin", "showActivityStatus", "lastActiveAt",
        "accountVisibility", "friendsVisibility", "updatedAt",
        "photoOriginalURL", "photoOriginalPublicId", "avatarPositionX", "avatarPositionY",
        "avatarCropX", "avatarCropY", "avatarZoom", "coverOriginalURL",
        "coverOriginalPublicId", "coverPositionX", "coverPositionY", "coverCropX",
        "coverCropY", "coverZoom"
      ]);
    }

    function hasOnlyLegacyPublicUserFields(data) {
      return data.keys().hasOnly([
        "displayName", "fullName", "name", "avatar", "username", "usernameNormalized", "usernameConfigured",
        "profileImage", "photoURL", "photoPublicId", "coverURL", "coverPublicId",
        "biography", "location", "work", "education", "relationshipStatus",
        "createdAt", "role", "accountStatus",
        "profileArchivedByAdmin", "showActivityStatus", "lastActiveAt",
        "accountVisibility", "friendsVisibility", "friends", "friendRequests",
        "followers", "following", "updatedAt", "photoOriginalURL",
        "photoOriginalPublicId", "avatarPositionX", "avatarPositionY", "avatarCropX",
        "avatarCropY", "avatarZoom", "coverOriginalURL", "coverOriginalPublicId",
        "coverPositionX", "coverPositionY", "coverCropX", "coverCropY", "coverZoom"
      ]);
    }

    function onlyActorMembershipAdded(before, after) {
      return before is list && after is list
        && !(request.auth.uid in before)
        && request.auth.uid in after
        && after.hasAll(before)
        && after.size() == before.size() + 1;
    }

    function onlyActorMembershipRemoved(before, after) {
      return before is list && after is list
        && request.auth.uid in before
        && !(request.auth.uid in after)
        && before.hasAll(after)
        && after.size() + 1 == before.size();
    }

    match /usersPublic/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isOwner(userId)
        && hasOnlyPublicProfileFields(request.resource.data)
        && request.resource.data.get("role", "user") == "user"
        && request.resource.data.get("accountStatus", "active") == "active");
      allow update: if isAdmin()
        || (!securityMigrationComplete()
          && isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["role", "accountStatus", "profileArchivedByAdmin"]))
        || (isOwner(userId)
          && hasOnlyPublicProfileFields(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "role", "accountStatus", "profileArchivedByAdmin"
          ]));
      allow delete: if isAdmin();
    }

    match /usersPrivate/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /memberIds/{memberId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn()
        && !exists(/databases/$(database)/documents/memberIds/$(memberId))
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time);
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Một hồ sơ phiên đang hoạt động cho mỗi tài khoản. Thiết bị đăng nhập mới
    // thay thế hồ sơ này; các thiết bị cũ nhận thay đổi realtime và đăng xuất.
    match /activeSessions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "uid", "sessionId", "browserId", "clientLabel",
          "claimedAt", "lastSeenAt", "expiresAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() >= 32
        && request.resource.data.sessionId.size() <= 128
        && request.resource.data.browserId is string
        && request.resource.data.browserId.size() >= 32
        && request.resource.data.browserId.size() <= 128
        && request.resource.data.clientLabel is string
        && request.resource.data.clientLabel.size() <= 120
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
          || isAdmin());
      allow create: if isAdmin()
        || (signedIn()
        && request.resource.data.keys().hasOnly(["senderId", "recipientId", "status", "createdAt"])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && requestId == request.auth.uid + "_" + request.resource.data.recipientId);
      allow update: if isAdmin()
        || (signedIn()
        && resource.data.recipientId == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.status in ["accepted", "declined"]
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "resolvedAt"]));
      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
          || isAdmin());
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn()
        && (request.auth.uid in resource.data.members || isAdmin());
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.keys().hasOnly(["members", "createdFromRequest", "createdAt"])
          && request.resource.data.members is list
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.createdFromRequest)).data.recipientId == request.auth.uid
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.createdFromRequest)).data.status == "accepted"
          && request.resource.data.members.hasAll([
            getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.createdFromRequest)).data.senderId,
            request.auth.uid
          ]));
      allow update: if isAdmin();
      allow delete: if signedIn()
        && (request.auth.uid in resource.data.members || isAdmin());
    }

    match /follows/{followId} {
      allow read: if signedIn()
        && (resource.data.followerId == request.auth.uid
          || resource.data.targetId == request.auth.uid
          || isAdmin());
      allow create: if isAdmin()
        || (signedIn()
        && request.resource.data.keys().hasOnly(["followerId", "targetId", "createdAt"])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.createdAt == request.time
        && followId == request.auth.uid + "_" + request.resource.data.targetId);
      allow update: if isAdmin();
      allow delete: if signedIn()
        && (resource.data.followerId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && hasOnlyLegacyPublicUserFields(request.resource.data)
        && request.resource.data.role == "user";
      allow update: if isAdmin()
        || (!securityMigrationComplete()
          && isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["role", "accountStatus", "profileArchivedByAdmin"]))
        || (!securityMigrationComplete()
          && signedIn()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["friendRequests"])
          && (onlyActorMembershipAdded(resource.data.get("friendRequests", []), request.resource.data.get("friendRequests", []))
            || onlyActorMembershipRemoved(resource.data.get("friendRequests", []), request.resource.data.get("friendRequests", []))))
        || (!securityMigrationComplete()
          && signedIn()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["friends"])
          && (onlyActorMembershipAdded(resource.data.get("friends", []), request.resource.data.get("friends", []))
            || onlyActorMembershipRemoved(resource.data.get("friends", []), request.resource.data.get("friends", []))))
        || (isOwner(userId)
          && hasOnlyLegacyPublicUserFields(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["role", "accountStatus", "profileArchivedByAdmin", "friendRequests", "followers"]))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["friends"])
          && ((onlyActorMembershipAdded(resource.data.get("friends", []), request.resource.data.get("friends", []))
              && existsAfter(/databases/$(database)/documents/friendships/$(friendshipDocumentId(request.auth.uid, userId))))
            || (onlyActorMembershipRemoved(resource.data.get("friends", []), request.resource.data.get("friends", []))
              && !existsAfter(/databases/$(database)/documents/friendships/$(friendshipDocumentId(request.auth.uid, userId))))))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["followers"])
          && ((onlyActorMembershipAdded(resource.data.get("followers", []), request.resource.data.get("followers", []))
              && existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + "_" + userId)))
            || (onlyActorMembershipRemoved(resource.data.get("followers", []), request.resource.data.get("followers", []))
              && !existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + "_" + userId)))));
      allow delete: if isAdmin();
    }

    // Username remains a public-facing identifier, but its document never
    // exposes an email address. Login resolution belongs on a trusted backend.
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == request.time);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if (!securityMigrationComplete() && signedIn())
        || isAdmin()
        || (signedIn()
          && (resource.data.authorId == request.auth.uid
            || (resource.data.get("moderationStatus", null) == null
              && resource.data.get("deletedByAdmin", false) == false
              && (resource.data.get("privacy", "public") == "public"
            || (resource.data.get("privacy", "public") == "friends"
                && request.auth.uid in resource.data.get("audienceIds", []))))));
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.get("privacy", "public") in ["public", "friends", "private"]
        && optionalBoundedString(request.resource.data, "content", 10000)
        && optionalBoundedList(request.resource.data, "hashtags", 20)
        && optionalBoundedList(request.resource.data, "mentions", 20)
        && optionalCloudinaryUrl(request.resource.data, "attachedImage")
        && optionalCloudinaryUrl(request.resource.data, "mediaUrl")
        && optionalPostMediaList(request.resource.data)
        && request.resource.data.get("moderationStatus", null) == null
        && request.resource.data.get("deletedByAdmin", false) == false
        && !request.resource.data.keys().hasAny([
          "moderationReason", "moderatedAt", "moderatedBy", "restoredAt", "appeal"
        ])
        && (!securityMigrationComplete()
          || (request.resource.data.audienceIds is list
            && request.resource.data.audienceIds.size() <= 500
            && (request.resource.data.privacy == "public"
              || request.auth.uid in request.resource.data.audienceIds)));
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get("privacy", "public") in ["public", "friends", "private"]
          && optionalBoundedString(request.resource.data, "content", 10000)
          && optionalBoundedList(request.resource.data, "hashtags", 20)
          && optionalBoundedList(request.resource.data, "mentions", 20)
          && optionalCloudinaryUrl(request.resource.data, "attachedImage")
          && optionalCloudinaryUrl(request.resource.data, "mediaUrl")
          && optionalPostMediaList(request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["reactions"])
            || actorOwnsReactionChange("reactions"))
          && resource.data.get("moderationStatus", null) == null
          && resource.data.get("deletedByAdmin", false) == false
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "moderationStatus", "moderationReason", "moderatedAt", "moderatedBy",
            "deletedByAdmin", "restoredAt"
          ])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["appeal"]))
        || (signedIn()
          && resource.data.authorId == request.auth.uid
          && resource.data.get("moderationStatus", "hidden") == "hidden"
          && resource.data.get("deletedByAdmin", false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["appeal"])
          && request.resource.data.appeal is map
          && request.resource.data.appeal.status == "pending"
          && request.resource.data.appeal.message is string
          && request.resource.data.appeal.message.size() >= 10
          && request.resource.data.appeal.message.size() <= 1000
          && request.resource.data.appeal.submittedAt == request.time
          && request.resource.data.appeal.keys().hasOnly([
            "status", "message", "submittedAt", "reviewedAt", "reviewNote"
          ]))
        || (signedIn()
          && resource.data.get("moderationStatus", null) == null
          && resource.data.get("deletedByAdmin", false) == false
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["reactions", "commentCount", "shareCount"])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["reactions"])
            || actorOwnsReactionChange("reactions"))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["commentCount"])
            || boundedCounterChange("commentCount"))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["shareCount"])
            || boundedCounterChange("shareCount")));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && optionalBoundedString(request.resource.data, "content", 2000)
          && optionalCloudinaryUrl(request.resource.data, "attachedImage")
          && postIsActive(postId);
        allow update: if isAdmin()
          || (signedIn()
            && postIsActive(postId)
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.createdAt == resource.data.createdAt
            && optionalBoundedString(request.resource.data, "content", 2000)
            && optionalCloudinaryUrl(request.resource.data, "attachedImage")
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["commentReactions"])
              || actorOwnsReactionChange("commentReactions")))
          || (signedIn()
            && postIsActive(postId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["commentReactions"])
            && actorOwnsReactionChange("commentReactions"));
        allow delete: if isAdmin()
          || (signedIn()
            && postIsActive(postId)
            && resource.data.authorId == request.auth.uid);
      }

      match /shares/{shareId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.sharerId == request.auth.uid
          && request.resource.data.recipientId is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(["sharerId", "recipientId", "createdAt"]);
        allow update, delete: if isAdmin();
      }
    }

    // Một tài khoản chỉ có một hồ sơ báo cáo cho mỗi bài viết. Người bị báo cáo
    // không thể đọc nội dung/lý do; chỉ người gửi và quản trị viên được đọc.
    match /postReports/{reportId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "postId", "postAuthorId", "reporterId", "reason", "status", "createdAt"
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postAuthorId != request.auth.uid
        && reportId == request.resource.data.postId + "_" + request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        || (signedIn()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.postAuthorId == resource.data.postAuthorId
        && request.resource.data.status == "pending"
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reason", "createdAt"]));
      allow delete: if isAdmin();
    }

    // Dấu trang là dữ liệu riêng của người lưu. Tác giả bài viết và người dùng
    // khác không thể biết ai đã lưu bài của họ.
    match /savedPosts/{saveId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["userId", "postId", "createdAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.postId.size() <= 160
        && saveId == request.auth.uid + "_" + request.resource.data.postId
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Ứng dụng hiện đọc các thông báo theo collection rồi lọc ở client.
    match /notifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.recipientId == request.auth.uid
          || resource.data.actorId == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.createdAt == request.time
        && optionalBoundedString(request.resource.data, "actorName", 120)
        && optionalBoundedString(request.resource.data, "message", 500);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.actorId == resource.data.actorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "isRead", "friendRequestStatus", "resolvedAt"
          ]));
      allow delete: if signedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Public game clients may read live operations settings; only administrators
    // can publish or alter them from the Admin workspace.
    match /gameSettings/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /messageNotifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.recipientId == request.auth.uid
          || resource.data.senderId == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead"]));
      allow delete: if signedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Mỗi thành viên chỉ có một ghi chú Messenger đang hoạt động.
    // Chỉ chủ sở hữu và người đã kết bạn mới có thể đọc ghi chú này.
    match /messengerNotes/{userId} {
      allow read: if isOwner(userId)
        || isFriendOf(userId)
        || (resource.data.get("visibleTo", []) is list
          && request.auth.uid in resource.data.get("visibleTo", []));
      allow create, update: if isOwner(userId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 160
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.visibleTo is list
        && request.resource.data.visibleTo.hasOnly(
          get(/databases/$(database)/documents/users/$(userId)).data.get("friends", []))
        && request.resource.data.keys().hasOnly([
          "authorId", "content", "createdAt", "expiresAt", "visibleTo",
          "mediaUrl", "mediaType", "gameResult"
        ])
        && (!request.resource.data.keys().hasAny(["mediaUrl"])
          || request.resource.data.mediaUrl is string)
        && (!request.resource.data.keys().hasAny(["mediaType"])
          || request.resource.data.mediaType == "image")
        && (!request.resource.data.keys().hasAny(["gameResult"])
          || request.resource.data.gameResult is map);
      allow delete: if isOwner(userId);

      match /reactions/{reactorId} {
        allow get: if isOwner(userId) || isOwner(reactorId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(reactorId)
          && isFriendOf(userId)
          && exists(/databases/$(database)/documents/messengerNotes/$(userId))
          && get(/databases/$(database)/documents/messengerNotes/$(userId)).data.expiresAt > request.time
          && request.resource.data.keys().hasOnly(["reactorId", "type", "createdAt"])
          && request.resource.data.reactorId == request.auth.uid
          && request.resource.data.type in ["like", "love", "haha", "wow", "sad", "support"]
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(reactorId) || isOwner(userId);
      }
    }

    match /conversations/{conversationId} {
      // Admin chỉ quan sát metadata cuộc trò chuyện ở cấp collection; nội dung tin nhắn
      // vẫn được bảo vệ bởi rule riêng trong /messages.
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 50
        && request.auth.uid in request.resource.data.members;
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid in resource.data.get("admins", [])
          && request.resource.data.members is list
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "members", "title", "admins", "updatedAt", "lastMessageAt", "typing", "nicknames", "theme", "appearance"
          ]))
        || (signedIn()
          && request.auth.uid in resource.data.members
          // Hai phía có thể ghi cùng hai UID theo thứ tự khác nhau. So sánh
          // như một tập hợp để không chặn nhầm, nhưng vẫn cấm đổi thành viên.
          && request.resource.data.members is list
          && request.resource.data.members.size() == resource.data.members.size()
          && request.resource.data.members.hasAll(resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "members", "updatedAt", "lastMessageAt", "typing", "nicknames", "theme", "appearance"
          ]));
      allow delete: if isAdmin();

      // Tùy chỉnh riêng của mỗi thành viên: nền cá nhân và trạng thái tắt thông báo.
      match /memberSettings/{userId} {
        allow read, delete: if signedIn()
          && request.auth.uid == userId
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.keys().hasOnly([
            "customBackgroundImageUrl", "customBackgroundPublicId",
            "customBackgroundFormat", "customBackgroundBytes",
            "customBackgroundWidth", "customBackgroundHeight",
            "customBackgroundEmoji",
            "backgroundOverlay", "backgroundBlur", "backgroundFit",
            "mutedUntil", "updatedAt"
          ]);
      }

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && optionalBoundedString(request.resource.data, "content", 4000)
          && optionalCloudinaryUrl(request.resource.data, "mediaUrl")
          && (!request.resource.data.keys().hasAny(["mediaType"])
            || request.resource.data.mediaType == null
            || request.resource.data.mediaType in ["image", "video", "audio"])
          && (!request.resource.data.keys().hasAny(["recipientIds"])
            || (request.resource.data.recipientIds is list
              && request.resource.data.recipientIds.size() <= 49))
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && (
            request.resource.data.recipientId in
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
            || (request.resource.data.recipientIds is list
              && get(/databases/$(database)/documents/conversations/$(conversationId)).data.members.hasAll(request.resource.data.recipientIds))
          );
        allow update: if isAdmin()
          || (signedIn()
            && request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
            && request.auth.uid != resource.data.senderId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
            && request.resource.data.readBy is list
            && request.auth.uid in request.resource.data.readBy)
          || (signedIn()
            && resource.data.recipientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
            && request.resource.data.readAt == request.time)
          || (signedIn()
            && request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            && request.resource.data.reactions is map
            && request.resource.data.reactions.diff(resource.data.get("reactions", {}))
              .affectedKeys().hasOnly([request.auth.uid]))
          || (signedIn()
            && request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenFor"])
            && request.resource.data.hiddenFor is list
            && request.auth.uid in request.resource.data.hiddenFor
            && request.resource.data.hiddenFor.hasAll(resource.data.get("hiddenFor", []))
            && request.resource.data.hiddenFor.size() == resource.data.get("hiddenFor", []).size() + 1)
          || (signedIn()
            && resource.data.senderId == request.auth.uid
            && resource.data.get("revoked", false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "revoked", "revokedAt", "content", "mediaUrl", "mediaType", "mediaPublicId",
              "sharedPost", "noteReply", "replyTo", "reactions"
            ])
            && request.resource.data.revoked == true
            && request.resource.data.revokedAt == request.time
            && request.resource.data.content == "");
        allow delete: if isAdmin()
          || (signedIn() && resource.data.senderId == request.auth.uid);
      }
    }

    match /gameLeaderboards/{gameId}/scores/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && gameId == "gravity-tourist"
        && request.resource.data.keys().hasOnly([
          "userId", "displayName", "photoURL", "highScore", "longestSurvival",
          "highestApproach", "longestCombo", "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.highScore is number
        && request.resource.data.highScore >= 0
        && request.resource.data.highScore <= 1000000000
        && request.resource.data.longestSurvival is number
        && request.resource.data.highestApproach is number
        && request.resource.data.longestCombo is number
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && gameId == "gravity-tourist"
        && request.resource.data.keys().hasOnly([
          "userId", "displayName", "photoURL", "highScore", "longestSurvival",
          "highestApproach", "longestCombo", "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.highScore is number
        && request.resource.data.highScore >= resource.data.highScore
        && request.resource.data.highScore <= 1000000000
        && request.resource.data.longestSurvival is number
        && request.resource.data.longestSurvival >= resource.data.longestSurvival
        && request.resource.data.highestApproach is number
        && request.resource.data.highestApproach >= resource.data.highestApproach
        && request.resource.data.longestCombo is number
        && request.resource.data.longestCombo >= resource.data.longestCombo
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /system/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
