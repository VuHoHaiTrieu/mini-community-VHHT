{
  "id": "./",
  "name": "VHHT Community",
  "short_name": "VHHT",
  "description": "Không gian cộng đồng, trò chuyện và trò chơi của VHHT.",
  "lang": "vi",
  "start_url": "./community/community-feed-page.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#020611",
  "theme_color": "#061426",
  "categories": ["social", "entertainment", "games"],
  "icons": [
    {
      "src": "./shared/assets/brand/vhht-logo-mark.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./shared/assets/brand/vhht-favicon.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    { "name": "Bảng tin", "url": "./community/community-feed-page.html", "icons": [{ "src": "./shared/assets/brand/vhht-logo-mark.png", "sizes": "512x512" }] },
    { "name": "Tin nhắn", "url": "./community/messages/messages-page.html", "icons": [{ "src": "./shared/assets/brand/vhht-logo-mark.png", "sizes": "512x512" }] },
    { "name": "Trò chơi", "url": "./games/", "icons": [{ "src": "./shared/assets/brand/vhht-logo-mark.png", "sizes": "512x512" }] }
  ]
}
